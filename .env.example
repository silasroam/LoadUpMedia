# ============================================================
#  ПРИМЕР ФАЙЛА С СЕКРЕТАМИ
# ============================================================
# Скопируйте этот файл в .env и подставьте свои значения:
#
#     cp .env.example .env
#
# .env добавлен в .gitignore и НЕ попадёт в git.
# Настоящий .env.example в репозиторий коммитить безопасно —
# здесь только плейсхолдеры.
# ============================================================

# Токен бота от @BotFather. ОБЯЗАТЕЛЬНАЯ переменная.
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Сколько видео обрабатывать одновременно.
# На тарифе Render Free (0.1 CPU / 512 МБ RAM) безопасное значение — 1.
MAX_CONCURRENT_DOWNLOADS=1

# Порт для HTTP health-check сервера.
# На Render задаётся автоматически; локально по умолчанию 10000.
# PORT=10000

# ============================================================
#  CLOUDFLARE R2 — для видео больше 50 МБ (лимит Telegram)
# ============================================================
# Telegram Bot API не даёт ботам отправлять в чат файлы > 50 МБ.
# Такие видео бот заливает в R2 и присылает ссылку. Если переменные
# не заданы — бот просто откажет по размеру, как раньше.
#
# 🔒 Ключи НЕЛЬЗЯ коммитить. Задавайте их здесь (в .env, он в .gitignore)
#    или на Render в Environment. При утечке — отозвать:
#    Cloudflare Dashboard → R2 → API → Manage API Tokens.
#
# Права токена выдавайте минимальные:
#   Permissions: Object Read & Write
#   Bucket: только ваш бакет (не "All buckets")

# ID аккаунта Cloudflare: R2 → Overview, в правой части страницы.
# Нужен для эндпоинта https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Ключи токена R2 (создаются в R2 → API → Manage API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Имя бакета, например: bot
R2_BUCKET=

# Необязательно: эндпоинт. Обычно собирается из R2_ACCOUNT_ID автоматически.
# ВНИМАНИЕ: https://cloudflarestorage.com НЕ работает — нужен адрес с ID.
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Сколько живёт ссылка на видео, в секундах (по умолчанию 3600 = 1 час).
# R2_LINK_TTL_SECONDS=3600

