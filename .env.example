# ============================================================
#  ПРИМЕР ФАЙЛА С СЕКРЕТАМИ
# ============================================================
# Скопируйте этот файл в .env и подставьте свои значения:
#
#     cp .env.example .env
#
# .env добавлен в .gitignore и НЕ попадёт в git.
# Настоящий .env.example в репозиторий коммитить безопасно —
# здесь только плейсхолдеры.
# ============================================================

# Токен бота от @BotFather. ОБЯЗАТЕЛЬНАЯ переменная.
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Сколько видео обрабатывать одновременно.
# На тарифе Render Free (0.1 CPU / 512 МБ RAM) безопасное значение — 1.
MAX_CONCURRENT_DOWNLOADS=1

# Порт для HTTP health-check сервера.
# На Render задаётся автоматически; локально по умолчанию 10000.
# PORT=10000

# ============================================================
#  СХЕМА РАБОТЫ
# ============================================================
# Бот работает по принципу «только файлы в чат»:
#   • скачивает видео в САМОМ ХУДШЕМ/СРЕДНЕМ качестве (маленький файл);
#   • видео ≤ 50 МБ отправляет файлом в чат и сразу удаляет с диска;
#   • видео > 50 МБ отклоняет с сообщением об ошибке.
#
# Облачных хранилищ и ссылок нет — никаких ключей R2/S3 задавать не нужно.
# 50 МБ — лимит Telegram Bot API на отправку файла ботом; его нельзя
# поднять (512 МБ на Render Free — это RAM сервера, а не размер файла).

